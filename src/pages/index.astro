---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>alepouna's movies & series ratings</title>
  </head>
  <body class="min-h-screen bg-zinc-950 px-4 py-8 text-zinc-100 sm:py-12">
    <main class="mx-auto w-full max-w-5xl">
      <h1 class="text-center text-4xl font-black text-white md:text-5xl">
        alepouna's movies & series ratings
      </h1>

      <p class="mt-4 text-center text-xs font-bold uppercase tracking-[0.24em] text-fuchsia-200">
        last updated: <span id="last-updated">loading</span>
      </p>

      <section class="mt-8 overflow-x-auto rounded-lg border border-zinc-800 bg-zinc-900 shadow-2xl shadow-black/30">
        <table class="w-full min-w-[42rem] border-collapse">
          <thead>
            <tr class="border-b border-zinc-800 bg-zinc-950 text-xs font-black uppercase tracking-[0.16em] text-fuchsia-200">
              <th class="px-5 py-4 text-left">Movie or series</th>
              <th class="px-5 py-4 text-center">Rating</th>
              <th class="px-5 py-4 text-right">Date watched</th>
            </tr>
          </thead>
          <tbody class="text-sm font-semibold text-zinc-100 md:text-base" id="letable"></tbody>
        </table>
      </section>
    </main>
  </body>
  <script src="../scripts/thing.ts"></script>
</html>
